# このファイルを .env にコピーして、キーを記入してください。
# .env は .gitignore 済みです。
#
#   cp .env.example .env
#
# Gemini API キーの取得: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# 任意。未指定なら gemma-4-31b-it を使用します。
GEMINI_MODEL=gemma-4-31b-it

# パスワードログイン（任意）。設定すると本番(Vercel)で利用にパスワードが必要になる。
# 未設定なら誰でも利用可。ローカル開発(npm run dev)では常に無効。
# 例: SITE_PASSWORD=harukaze2026
SITE_PASSWORD=
